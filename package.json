{
	"name": "pokemon-start-app",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "prisma generate && next build",
		"start": "next start",
		"lint": "next lint",
		"postinstall": "prisma generate",
		"stripewebhook": "stripe listen --forward-to localhost:420/api/stripe/webhook",
