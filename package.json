		"eventtrigger": "stripe trigger payment_intent.succeeded",
		"postgresqlinstall": "bunx prisma init --datasource-provider postgresql",
		"setdb": "prisma db pull",
		"vercel-build": "prisma generate && prisma migrate deploy && next build",
		"create-migrate": "prisma migrate dev --name init",
		"migrate": "prisma migrate deploy",
		"view-db": "prisma studio"
	},
	"prisma": {
		"seed": "ts-node prisma/seed.ts"
	},
